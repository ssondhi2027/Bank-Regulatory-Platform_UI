<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE suite SYSTEM
        "https://testng.org/testng-1.0.dtd">

<suite name="Bank Regulatory Platform QA">

    <test name="Smoke Tests">

        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>

        <packages>
            <package name="tests"/>
            <package name="api"/>
        </packages>

    </test>

    <test name="Regression Tests">

        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>

        <packages>
            <package name="tests"/>
            <package name="api"/>
        </packages>

    </test>

</suite>